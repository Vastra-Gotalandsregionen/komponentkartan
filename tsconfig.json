{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "es2020",
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "strict": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "vgr-komponentkartan": [
        "../projects/komponentkartan/src/lib/index.ts"
      ],
      "@komponentkartan-module": [
        "../projects/komponentkartan/src/lib/komponentkartan.module"
      ]
    },
    "useDefineForClassFields": false
  }
}
